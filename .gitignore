# Build artifacts
/bin/
/dist/
/codexlb2otel
*.out

# Scratch plans and specs - NEVER committed
docs/superpowers/

# Local config with secrets
config.yaml
.env

# Captured archives. These hold FULL conversation content - prompts, tool output,
# assistant messages - so committing one is a personal-data leak that survives in
# git history forever. The whole corpus tree is ignored, plus the file extensions
# wherever they land, and TestNoArchivesAreTracked fails the build if anything of
# this shape is ever staged anyway.
/corpus/*
!/corpus/sync
*.jsonl
*.jsonl.gz
*.jsonl.zst
testdata/live*/

# Induced-schema dumps: clbprofile -out writes example VALUES from real records.
# The committed baseline is corpus.sig.json, which is content-free by construction.
shapes*.json
*.profile.json

# The Backlog.md guard hook and its settings ARE tracked, deliberately: they
# enforce the tracker rules (bare --notes/--plan replaces a section silently;
.claude/
