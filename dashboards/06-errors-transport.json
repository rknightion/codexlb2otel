        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (codexlb_request_kind) (rate(codexlb_baseline_resets_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{codexlb_request_kind}}"
        }
      ]
    }
  ]
}
