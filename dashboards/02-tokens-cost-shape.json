{
  "uid": "codexlb-tokens-cost-shape",
  "title": "codexlb2otel: Token & cost shape",
  "description": "Token volume by model, effort and thread source. Complements codex-lb-overview's spend panels.",
  "tags": [
    "codexlb2otel",
    "codex-lb",
    "tokens",
    "cost"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total{service_name=~\"$service_name\"}, gen_ai_request_model)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Token and cost shape by model, effort and thread source. Complements `codex-lb-overview` (the proxy's own Postgres-derived view); every panel here is built from the wire-capture telemetry only codexlb2otel emits. `codexlb.tokens` carries model, reasoning effort, thread source, family, and API-key dimensions. The panels use that counter directly and exclude `codexlb_family=\"probe\"`, so synthetic health traffic does not inflate user-token views. Input and output are additive parents; cache_read, cache_write, and reasoning are nested breakdowns and must not be added on top."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Additive token volume by type",
      "description": "codexlb.tokens counter, restricted to additive input and output values. Probe traffic is excluded.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (gen_ai_token_type) (rate(codexlb_tokens_total{service_name=~\"$service_name\", gen_ai_request_model=~\"$model\", codexlb_family!=\"probe\", gen_ai_token_type=~\"input|output\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Input+output token volume by model",
