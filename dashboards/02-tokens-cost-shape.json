          "expr": "sum by (gen_ai_request_model) (rate(codexlb_tokens_total{service_name=~\"$service_name\", gen_ai_token_type=~\"input|output\", gen_ai_request_model=~\"$model\", codexlb_family!=\"probe\"}[$__rate_interval]))",
          "refId": "A",
