          "expr": "histogram_quantile(0.90, sum by (le, gen_ai_request_model) (rate(codexlb_turn_duration_seconds_bucket{codexlb_family!=\"probe\", service_name=~\"$service_name\", gen_ai_request_model=~\"$model\"}[$__rate_interval])))",
