{
  "uid": "codexlb-rate-limits-accounts",
  "title": "codexlb2otel: Rate limits & credits (per account)",
  "description": "Per-account rate-limit headroom and credits - the load-balancer view. Complements codex-lb-overview.",
  "tags": [
    "codexlb2otel",
    "codex-lb",
    "rate-limits"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      },
      {
        "name": "account_id",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total{service_name=~\"$service_name\"}, codexlb_account_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total{service_name=~\"$service_name\"}, gen_ai_request_model)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Per-account rate-limit headroom and credits from the wire capture (response headers), never averaged across accounts - that collapses exactly the exhaustion a load balancer needs to see. Complements `codex-lb-overview` (the proxy's own Postgres-derived view); every panel here is built from the wire-capture telemetry only codexlb2otel emits. All four gauges are grouped by `codexlb_account_id`; none of them carries `codexlb.family` or `codexlb.request_kind` (record.go's `recordRateLimits`: `accountAttrs = Only(base, AccountID, PlanType)`, `+GenAIRequestModel` for the per-model gauge only) - these are per-account snapshots off the response's rate-limit block, not per-request measurements, so there is nothing to filter probe traffic out of here."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Primary window headroom used, per account",
      "description": "codexlb.rate_limit.used_percent, gauge. Never averaged: one series per account_id.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "codexlb_rate_limit_used_percent{service_name=~\"$service_name\", codexlb_account_id=~\"$account_id\"}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{codexlb_account_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Primary window reset countdown, per account",
      "description": "codexlb.rate_limit.reset_after, gauge.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "codexlb_rate_limit_reset_after_seconds{service_name=~\"$service_name\", codexlb_account_id=~\"$account_id\"}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{codexlb_account_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Secondary window headroom used, per account",
