    {
      "id": 6,
      "type": "stat",
      "title": "Credit balance, per account",
      "description": "codexlb.credits.balance, gauge. Unit as reported on the wire is not asserted by the service (parseCreditsBalance strips a leading $ and thousands separators) - treat as a raw number, not a currency-typed field.",
      "gridPos": {
