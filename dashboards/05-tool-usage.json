{
  "uid": "codexlb-tool-usage",
  "title": "codexlb2otel: Tool usage",
  "description": "Tool usage by name, and the shape of tool-call activity per response.",
  "tags": [
    "codexlb2otel",
    "codex-lb",
    "tools"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(codexlb_responses_total, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Tool usage by name. Complements `codex-lb-overview` (the proxy's own Postgres-derived view); every panel here is built from the wire-capture telemetry only codexlb2otel emits."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool call rate by name",
      "description": "codexlb.tool_calls, by gen_ai.tool.name (renamed from codexlb.tool_name, issue #18). Capped at 64 distinct values (attr.go's registry) - the widest-margin bounded field in the contract, since a tool name is whatever the model's catalogue happens to contain.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (gen_ai_tool_name) (rate(codexlb_tool_calls_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tool calls per response, p50/p90",
      "description": "gen_ai.client.tool_calls_per_operation, recorded once per response including the zero case, so this reflects every operation, not only tool-using ones.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_tool_calls_per_operation_count_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(gen_ai_client_tool_calls_per_operation_count_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "refId": "B",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top tools by call count, this range",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "topk(15, sum by (gen_ai_tool_name) (increase(codexlb_tool_calls_total{service_name=~\"$service_name\"}[$__range])))",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Web-search requests, rate",
      "description": "codexlb.web_search_requests - server-tool-use calls the model issued; no standard GenAI convention name exists for this concept (checked 2026-08-07, names.go's own comment).",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (gen_ai_request_model) (rate(codexlb_web_search_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Image-generation tokens, rate",
      "description": "codexlb.image_gen_tokens - separate from the response's own gen_ai.token.type breakdown.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (gen_ai_request_model) (rate(codexlb_image_gen_tokens_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    }
  ]
}
