    {
      "id": 5,
      "type": "timeseries",
      "title": "Decode errors vs partial-member reads (NOT the same thing)",
      "description": "codexlb.selfobs.decode_errors: complete-but-corrupt gzip members, genuine archive corruption. codexlb.selfobs.partial_member_reads: a member cut off mid-write by a file codex-lb is still appending to - deliberately a separate counter (issue #8's explicit acceptance criterion) so a dashboard never conflates them.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
