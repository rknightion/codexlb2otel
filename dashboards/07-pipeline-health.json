        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(rate(codexlb_selfobs_partial_member_reads_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "partial-member reads (normal steady state)"
        }
      ]
